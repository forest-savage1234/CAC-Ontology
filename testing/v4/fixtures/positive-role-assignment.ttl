@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix cac-core: <https://cacontology.projectvic.org/core#> .
@prefix ex: <https://example.invalid/v4-test#> .

ex:VictimRoleClassifier a owl:Class, gufo:Role .

ex:person-1 a cac-core:EnduringEntity .
ex:investigation-1 a cac-core:Situation .

ex:assignment-1 a cac-core:RoleAssignment ;
    cac-core:roleBearer ex:person-1 ;
    cac-core:roleClassifier ex:VictimRoleClassifier ;
    cac-core:roleContext ex:investigation-1 .

ex:record-1 a cac-core:RoleRecord ;
    cac-core:describesRoleAssignment ex:assignment-1 .
