# Query: conditioning_phase_analytics
# Purpose: Distribution of conditioningMode tags and offense-trajectory phase paths
#          (InitialContact → Conditioning → Exploitation → Maintenance)
# Data: examples_knowledge_graphs/conditioning-phase-offense-trajectory-example.ttl
#       examples_knowledge_graphs/wa-sextortion-case-example.ttl
#       examples_knowledge_graphs/caselinker-state-machine-extensions-example.ttl

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cac-core: <https://cacontology.projectvic.org/core#>
PREFIX cacontology-grooming: <https://cacontology.projectvic.org/grooming#>
PREFIX cacontology-platforms: <https://cacontology.projectvic.org/platforms#>
PREFIX cacontology-sextortion: <https://cacontology.projectvic.org/sextortion#>

# Part 1: conditioningMode distribution across macro ConditioningPhase instances
SELECT ?conditioningMode (COUNT(?phase) AS ?phaseCount)
WHERE {
    ?phase a cacontology-grooming:ConditioningPhase ;
           cac-core:conditioningMode ?conditioningMode .
}
GROUP BY ?conditioningMode
ORDER BY DESC(?phaseCount) ?conditioningMode
;

# Part 2: Complete Contact → Conditioning → Exploitation → Maintenance traversal.
SELECT ?contact ?contactLabel ?conditioning ?conditioningLabel ?conditioningMode
       ?exploitation ?exploitationLabel ?maintenance ?maintenanceLabel
WHERE {
    ?contact a cacontology-grooming:InitialContactPhase ;
             rdfs:label ?contactLabel ;
             cac-core:precedes ?conditioning .
    ?conditioning a cacontology-grooming:ConditioningPhase ;
                  rdfs:label ?conditioningLabel ;
                  cac-core:conditioningMode ?conditioningMode ;
                  cac-core:precedes ?exploitation .
    ?exploitation a cacontology-grooming:ExploitationPhase ;
                  rdfs:label ?exploitationLabel ;
                  cac-core:precedes ?maintenance .
    ?maintenance a cacontology-grooming:MaintenancePhase ;
                 rdfs:label ?maintenanceLabel .
}
ORDER BY ?contactLabel ?conditioningLabel
;

# Part 3: Transition evidence supplied by platform affordance misuse.
SELECT ?misuse ?misuseLabel ?affordance ?fromPhase ?fromLabel ?toPhase ?toLabel
WHERE {
    ?misuse a cacontology-platforms:AffordanceMisuse ;
            cacontology-platforms:affordanceClass ?affordance ;
            cacontology-platforms:enablesTransitionFrom ?fromPhase ;
            cacontology-platforms:enablesTransitionTo ?toPhase .
    OPTIONAL { ?misuse rdfs:label ?misuseLabel }
    OPTIONAL { ?fromPhase rdfs:label ?fromLabel }
    OPTIONAL { ?toPhase rdfs:label ?toLabel }
}
ORDER BY ?fromLabel ?toLabel
;

# Part 4: State-machine edges, including direct progression, channel migration,
# and coercion-cycle back-edges.
SELECT ?edgeKind ?edge ?fromState ?fromLabel ?toState ?toLabel
WHERE {
    {
        ?fromState cac-core:precedes ?toState .
        BIND("precedes" AS ?edgeKind)
        BIND(?fromState AS ?edge)
    }
    UNION
    {
        ?edge a cacontology-platforms:AffordanceMisuse ;
              cacontology-platforms:enablesTransitionFrom ?fromState ;
              cacontology-platforms:enablesTransitionTo ?toState .
        BIND("affordance transition" AS ?edgeKind)
    }
    UNION
    {
        ?edge a cacontology-platforms:ChannelMigrationEvent ;
              cacontology-platforms:occursBetween ?fromState, ?toState .
        FILTER(STR(?fromState) < STR(?toState))
        BIND("channel migration" AS ?edgeKind)
    }
    UNION
    {
        ?edge a cacontology-sextortion:CoercionCycle ;
              cacontology-sextortion:cyclesBetween ?fromState, ?toState .
        FILTER(STR(?fromState) < STR(?toState))
        BIND("coercion cycle" AS ?edgeKind)
    }
    OPTIONAL { ?fromState rdfs:label ?fromLabel }
    OPTIONAL { ?toState rdfs:label ?toLabel }
}
ORDER BY ?edgeKind ?fromLabel ?toLabel
